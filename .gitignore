# Machine-local state created by agent harnesses. Shared configuration
# (AGENTS.md, CLAUDE.md, .claude/settings.json, .github/copilot-instructions.md)
# stays tracked.
#
# Portable by design: copy or merge this file into any repository that hosts
# these skills, so agent-generated state and secrets cannot be committed there.
#
# Do not add .agents/ or any agent link to this file (.claude/skills,
# .github/skills, .cursor/skills, ...). They are the tracked skill tree and the
# links that expose it to each agent.

# Claude Code
CLAUDE.local.md
.claude/*.local.json
.claude/worktrees/
.claude/agent-memory/

# Aider history and tag cache
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/

# SpecStory session history
.specstory/

# Agent-created worktrees outside the main checkout
.agent-worktrees/

# Local environment files agents tend to create
.env
.env.local
.env.*.local

# OS noise
.DS_Store
Thumbs.db
desktop.ini
